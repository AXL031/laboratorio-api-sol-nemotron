  "components": {
    "securitySchemes": {
      "LabBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Tokens de fixtures locales LAB_ADMIN_TOKEN / LAB_READER_TOKEN. No JWT ni integración con Seguridad."
      }
    },
    "schemas": {
      "Alcance": {
        "type": "object",
        "properties": {
          "productIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "skus": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "productIds"
            ],
            "properties": {
              "productIds": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "skus"
            ],
            "properties": {
              "skus": {
                "minItems": 1
              }
            }
          }
        ]
      },
      "PoliticaCombinacion": {
        "type": "object",
        "properties": {
          "ofertaPricing": {
            "type": "boolean"
          },
          "promocionAutomatica": {
            "type": "boolean"
          },
          "cupon": {
            "type": "boolean"
          }
        },
        "required": [
