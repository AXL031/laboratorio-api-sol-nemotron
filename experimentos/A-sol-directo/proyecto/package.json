{
  "name": "lab-promociones",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "npm run build && npm start",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "24.0.0",
    "@types/pg": "8.23.1",
    "@nestjs/testing": "12.0.1",
    "typescript": "6.0.2",
    "vitest": "4.1.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.0.0"
  }
}
